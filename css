.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-heading h2 {
  font-size: 22px;
}

.track-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.track-card {
  padding: 13px;
  background: #202020;
  border-radius: 12px;
  transition: .2s;
}

.track-card:hover {
  background: #30251e;
  transform: translateY(-4px);
}

.cover {
  aspect-ratio: 1;
  border-radius: 9px;
  background: linear-gradient(135deg, #a45b2b, #24140e);
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  font-size: 55px;
  color: #ffd1a9;
}

.cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover button {
  position: absolute;
  left: 10px;
  bottom: 10px;
  border: 0;
  width: 43px;
  height: 43px;
  border-radius: 50%;
  background: var(--orange);
  color: black;
}

.track-card h3 {
  font-size: 13px;
  margin: 12px 0 3px;
}

.track-card p {
  color: var(--muted);
  font-size: 11px;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.heart, .like {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 21px;
}

.heart.liked, .like.liked {
  color: var(--orange);
}

.categories {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.category {
  height: 110px;
  border: 0;
  border-radius: 12px;
  padding: 17px;
  font-weight: 900;
  text-align: right;
  font-size: 16px;
}

.orange { background: #80451f; }
.purple { background: #513b68; }
.blue { background: #284b62; }
.red { background: #69332e; }

.track-list {
  display: grid;
  gap: 8px;
}

.track-row {
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr) 65px 35px;
  align-items: center;
  gap: 13px;
  padding: 10px;
  border-radius: 9px;
}

.track-row:hover {
  background: #242424;
}

.row-cover {
  width: 48px;
  height: 48px;
  border-radius: 7px;
  overflow: hidden;
  background: #80451f;
  display: grid;
  place-items: center;
}

.row-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.row-title {
  font-size: 13px;
  font-weight: 700;
}

.row-artist, .row-duration {
  color: var(--muted);
  font-size: 11px;
}

.row-play {
  background: transparent;
  border: 0;
  color: var(--orange);
}

.tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.tab {
  background: #292929;
  border: 0;
  padding: 9px 17px;
  border-radius: 20px;
  font-size: 12px;
}

.tab.active {
  background: var(--orange);
  color: #17100b;
}

.player {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  min-height: 95px;
  background: #111;
  border-top: 1px solid #382d25;
  display: grid;
  grid-template-columns: 1fr 1.3fr 1fr;
  align-items: center;
  gap: 15px;
  padding: 12px 25px;
}

.now-playing {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.mini-cover {
  width: 50px;
  height: 50px;
  border-radius: 7px;
  background: #663a21;
  display: grid;
  place-items: center;
  font-size: 23px;
  overflow: hidden;
}

.mini-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.track-info {
  display: grid;
  min-width: 0;
}

.track-info strong {
  font-size: 12px;
}

.track-info span {
  color: var(--muted);
  font-size: 10px;
}

.player-center {
  width: 100%;
  max-width: 550px;
  justify-self: center;
}

.controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
}

.controls button {
  background: none;
  border: 0;
  color: #aaa;
  font-size: 16px;
}

.controls button.active {
  color: var(--orange);
}

.controls .play-button {
  background: #f5f0ea;
  color: #111;
  width: 35px;
  height: 35px;
  border-radius: 50%;
}

.progress-container {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: 10px;
  margin-top: 8px;
}

.progress-container input {
  width: 100%;
}

input[type="range"] {
  accent-color: var(--orange);
}

@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg: #090909;
  --panel: #151515;
  --card: #202020;
  --orange: #f28b42;
  --white: #f8f5f1;
  --muted: #99918a;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--white);
  font-family: Vazirmatn, Tahoma, sans-serif;
  padding-bottom: 110px;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
  color: inherit;
}

.app {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  gap: 10px;
  padding: 10px;
  min-height: calc(100vh - 100px);
}

.sidebar, .main {
  background: var(--panel);
  border-radius: 16px;
}

.sidebar {
  padding: 25px 18px;
  display: flex;
  flex-direction: column;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 18px;
  font-weight: 900;
  color: white;
  text-decoration: none;
  margin-bottom: 38px;
  direction: ltr;
  justify-content: flex-end;
}

.logo b {
  color: var(--orange);
}

.logo-icon {
  background: var(--orange);
  color: #17100b;
  border-radius: 11px;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  font-size: 25px;
}

nav {
  display: grid;
  gap: 9px;
}

.nav-item {
  text-align: right;
  background: transparent;
  border: none;
  color: var(--muted);
  padding: 13px;
  border-radius: 9px;
}

.nav-item:hover, .nav-item.active {
  background: #30251e;
  color: white;
}

.nav-item.active {
  border-right: 3px solid var(--orange);
}

.sidebar-title {
  margin-top: 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 13px;
}

.sidebar-title button {
  background: transparent;
  border: none;
  color: var(--orange);
  font-size: 25px;
}

.playlist-list {
  display: grid;
  gap: 9px;
  margin-top: 15px;
}

.playlist-item {
  background: var(--card);
  border: 0;
  border-radius: 8px;
  padding: 12px;
  text-align: right;
  font-size: 12px;
}

.topbar {
  height: 76px;
  border-bottom: 1px solid #292929;
  display: flex;
  align-items: center;
  padding: 0 30px;
  justify-content: space-between;
  gap: 20px;
}

.search {
  background: #242424;
  border-radius: 30px;
  height: 43px;
  display: flex;
  align-items: center;
  padding: 0 15px;
  gap: 12px;
  width: min(450px, 65%);
}

.search span {
  color: var(--orange);
  font-size: 24px;
}

.search input {
  background: transparent;
  border: 0;
  outline: none;
  color: white;
  width: 100%;
  font-size: 12px;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--orange);
  color: black;
  display: grid;
  place-items: center;
  font-weight: 900;
}

.view {
  padding: 30px;
  max-width: 1500px;
  margin: auto;
}

.hidden {
  display: none !important;
}

.hero {
  min-height: 330px;
  border-radius: 15px;
  background:
    radial-gradient(circle at 80% 50%, #82451e55, transparent 32%),
    linear-gradient(115deg, #392317, #1d1815 65%, #171717);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 35px 7%;
  overflow: hidden;
}

.hero h1 {
  font-size: clamp(36px, 4vw, 58px);
  line-height: 1.3;
}

.hero h1 span {
  color: #ffb477;
}

.hero p {
  color: #c0b5ab;
  font-size: 13px;
}

.tag {
  color: var(--orange);
  font-size: 11px;
  font-weight: 800;
}

.main-button {
  margin-top: 15px;
  background: var(--orange);
  color: #17100b;
  border: none;
  border-radius: 30px;
  padding: 12px 24px;
  font-weight: 900;
}

.disc {
  width: 205px;
  height: 205px;
  border-radius: 50%;
  background: repeating-radial-gradient(circle, #171717 0 4px, #37302b 5px 7px);
  display: grid;
  place-items: center;
  box-shadow: 0 15px 60px #0009;
}

.disc-center {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  background: var(--orange);
  color: #17100b;
  display: grid;
  place-items: center;
  font-size: 32px;
  font-weight: 900;
}

.section {
  margin-top: 40px;
}

.volume {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}

.volume input {
  width: 100px;
}

.toast {
  position: fixed;
  bottom: 110px;
  left: 50%;
  transform: translateX(-50%);
  background: #30251e;
  border: 1px solid #65442e;
  border-radius: 25px;
  padding: 10px 18px;
  opacity: 0;
  pointer-events: none;
  transition: .2s;
  font-size: 12px;
  z-index: 20;
}

.toast.show {
  opacity: 1;
}

@media(max-width: 950px) {
  .track-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .app {
    grid-template-columns: 205px minmax(0, 1fr);
  }

  .player {
    grid-template-columns: 1fr 1.4fr;
  }

  .volume {
    display: none;
  }
}

@media(max-width: 650px) {
  body {
    padding-bottom: 155px;
  }

  .app {
    display: block;
    padding: 6px;
  }

  .sidebar {
    display: none;
  }

  .topbar {
    padding: 0 13px;
    height: 65px;
  }

  .view {
    padding: 17px;
  }

  .hero {
    min-height: 270px;
    padding: 20px;
  }

  .hero-visual {
    position: absolute;
    left: -70px;
    opacity: .4;
  }

  .track-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .categories {
    grid-template-columns: repeat(2, 1fr);
  }

  .player {
    min-height: 145px;
    grid-template-columns: 1fr;
    gap: 7px;
    padding: 9px 13px;
  }

  .volume {
    display: none;
  }
}