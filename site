<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>اسپاتی خامس | Spoti Khames</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="app">
  <aside class="sidebar">
    <a class="logo" href="#">
      <span class="logo-icon">خ</span>
      <span>SPOTI <b>KHAMES</b></span>
    </a>

    <nav>
      <button class="nav-item active" data-view="home">⌂ خانه</button>
      <button class="nav-item" data-view="search">⌕ جست‌وجو</button>
      <button class="nav-item" data-view="library">▤ کتابخانه من</button>
    </nav>

    <div class="sidebar-title">
      <span>کتابخانه تو</span>
      <button id="create-playlist">＋</button>
    </div>

    <div id="playlist-list" class="playlist-list"></div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="search">
        <span>⌕</span>
        <input id="search-input" type="search"
          placeholder="جست‌وجوی آهنگ یا خواننده...">
      </div>
      <div class="avatar">خ</div>
    </header>

    <section id="home-view" class="view">
      <section class="hero">
        <div class="hero-content">
          <span class="tag">دنیای موسیقی تو</span>
          <h1>موسیقی را<br><span>زندگی کن.</span></h1>
          <p>آهنگ مورد علاقه‌ات را پیدا کن و لذت ببر.</p>
          <button class="main-button" id="explore">کشف موسیقی ←</button>
        </div>
        <div class="hero-visual">
          <div class="disc"><div class="disc-center">خ</div></div>
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <h2>آهنگ‌های پیشنهادی</h2>
          <span class="tag">منتخب اسپاتی خامس</span>
        </div>
        <div id="track-grid" class="track-grid"></div>
      </section>

      <section class="section">
        <h2>دسته‌بندی موسیقی</h2>
        <div class="categories">
          <button data-category="همه" class="category orange">همه آهنگ‌ها ♫</button>
          <button data-category="پاپ" class="category purple">پاپ ✦</button>
          <button data-category="بی‌کلام" class="category blue">بی‌کلام 〰</button>
          <button data-category="راک" class="category red">راک ♪</button>
        </div>
      </section>
    </section>

    <section id="search-view" class="view hidden">
      <h1>جست‌وجوی موسیقی</h1>
      <div id="search-results" class="track-list"></div>
    </section>

    <section id="library-view" class="view hidden">
      <h1>کتابخانه من</h1>
      <div class="tabs">
        <button class="tab active" data-library="all">همه آهنگ‌ها</button>
        <button class="tab" data-library="liked">♥ پسندیده‌ها</button>
      </div>
      <div id="library-results" class="track-list"></div>
    </section>
  </main>
</div>

<footer class="player">
  <div class="now-playing">
    <div id="current-cover" class="mini-cover">♫</div>
    <div class="track-info">
      <strong id="current-title">هنوز آهنگی انتخاب نشده</strong>
      <span id="current-artist">اسپاتی خامس</span>
    </div>
    <button id="current-like" class="like">♡</button>
  </div>

  <div class="player-center">
    <div class="controls">
      <button id="shuffle">⤨</button>
      <button id="previous">|◀</button>
      <button id="play" class="play-button">▶</button>
      <button id="next">▶|</button>
      <button id="repeat">↻</button>
    </div>
    <div class="progress-container">
      <span id="current-time">0:00</span>
      <input type="range" id="progress" min="0" max="100" value="0">
      <span id="duration">0:00</span>
    </div>
  </div>

  <div class="volume">
    <span>🔊</span>
    <input type="range" id="volume" min="0" max="1" step="0.01" value="0.8">
  </div>

  <audio id="audio"></audio>
</footer>

<div id="toast" class="toast"></div>

<script src="script.js"></script>
</body>
</html>